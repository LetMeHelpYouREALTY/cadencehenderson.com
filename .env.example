# Get your v0 API key here: https://v0.dev/chat/settings/keys
V0_API_KEY="your_v0_api_key"

# RealScout embed ID from your RealScout dashboard (Customize > Copy embed code)
NEXT_PUBLIC_REALSCOUT_EMBED_ID=your_realscout_embed_id

# Optional: for rate limiting
KV_REST_API_URL=your_upstash_redis_rest_url
KV_REST_API_TOKEN=your_upstash_redis_rest_token

# Google Maps Platform — interactive amenity map (Maps JavaScript API + Places)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: Map ID for Advanced Markers styling
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Cloudflare Images (primary) + git public/images (fallback)
# SOP: docs/sop/cloudflare-images-git-fallback.md
# Token: Cloudflare Dashboard → My Profile → API Tokens → Account → Cloudflare Images → Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=2cc579c1ec9e426ed585e933ebf4753b
